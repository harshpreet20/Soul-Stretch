      "id": "extract-product",
      "name": "Extract Product Inquiry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 760]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are Ask Soul, the AI assistant for Soul Stretch, a premium Indian fitness equipment brand. You help customers with product info, orders, returns, and fitness guidance.\n\nKey product categories: Foam Rollers, Resistance Bands, Yoga Mats, Hand Grippers, Ab Rollers, Gym Gloves, Skipping Ropes, Foot Insoles, Pull-up Bars, Massage Guns, Knee Sleeves, Wrist Wraps, Lacrosse Balls.\n\nBrand values: Made in India, premium quality, affordable pricing, designed for Indian athletes.\n\nRules:\n- Be friendly, concise, and helpful\n- For pricing/availability, direct to WhatsApp: +91 92171 03413\n- For urgent issues, suggest contacting via WhatsApp\n- Recommend products based on user needs\n- Keep responses under 150 words\n- Use a conversational, energetic tone"
            },
            {
              "role": "user",
              "content": "={{ $json.message }}"
            }
          ]
        },
        "options": {
          "maxTokens": 300,
          "temperature": 0.7
        }
      },
      "id": "ai-response",
      "name": "AI Chat Response",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [960, 100],
      "notes": "Configure your OpenAI API key in n8n credentials. You can swap this for any LLM: Claude, Gemini, Ollama, etc."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "success", "value": true, "type": "boolean" },
            { "id": "r2", "name": "reply", "value": "={{ $json.message?.content || $json.text || 'Thanks for reaching out! Our team will get back to you shortly. For faster response, WhatsApp us at +91 92171 03413.' }}", "type": "string" },
            { "id": "r3", "name": "source", "value": "ai", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "format-ai-reply",
      "name": "Format AI Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "", "mode": "list" },
        "sheetName": { "__rl": true, "value": "ChatLogs", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $('Extract Chat Data').item.json.timestamp }}",
            "source": "chat_message",
            "name": "={{ $('Extract Chat Data').item.json.name }}",
            "email": "={{ $('Extract Chat Data').item.json.email }}",
            "message": "={{ $('Extract Chat Data').item.json.message }}",
            "ai_reply": "={{ $json.reply }}",
            "page": "={{ $('Extract Chat Data').item.json.page }}",
            "product": "={{ $('Extract Chat Data').item.json.product }}",
            "session_id": "={{ $('Extract Chat Data').item.json.session_id }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "timestamp", "displayName": "timestamp", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "source", "displayName": "source", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "name", "displayName": "name", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "email", "displayName": "email", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "message", "displayName": "message", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "ai_reply", "displayName": "ai_reply", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "page", "displayName": "page", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "product", "displayName": "product", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "session_id", "displayName": "session_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "log-chat",
      "name": "Log Chat to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1440, 100],
      "notes": "Sheet: ChatLogs. Columns: timestamp, source, name, email, message, ai_reply, page, product, session_id"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, reply: $('Format AI Reply').item.json.reply, source: 'ai' }) }}",
