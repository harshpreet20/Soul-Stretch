{
  "name": "Soul Stretch - AI Chatbot & Website Forms",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "soul-stretch-ai",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-main",
      "name": "Main Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.source }}",
                    "rightValue": "chat_message",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": "Chat Message"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.source }}",
                    "rightValue": "contact_form",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": "Contact Form"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.source }}",
                    "rightValue": "whatsapp_click",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": "WhatsApp Click"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.source }}",
                    "rightValue": "product_inquiry",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": "Product Inquiry"
            }
          ]
        },
        "options": {}
      },
      "id": "route-source",
      "name": "Route by Source",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "name", "value": "={{ $json.body.name || 'Visitor' }}", "type": "string" },
            { "id": "a2", "name": "email", "value": "={{ $json.body.email || '' }}", "type": "string" },
            { "id": "a3", "name": "message", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "a4", "name": "source", "value": "chat_message", "type": "string" },
            { "id": "a5", "name": "page", "value": "={{ $json.body.page || '/' }}", "type": "string" },
            { "id": "a6", "name": "product", "value": "={{ $json.body.product || '' }}", "type": "string" },
            { "id": "a7", "name": "timestamp", "value": "={{ $json.body.timestamp || new Date().toISOString() }}", "type": "string" },
            { "id": "a8", "name": "session_id", "value": "={{ $json.body.session_id || '' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "extract-chat",
      "name": "Extract Chat Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "name", "value": "={{ $json.body.name }}", "type": "string" },
            { "id": "b2", "name": "email", "value": "={{ $json.body.email }}", "type": "string" },
            { "id": "b3", "name": "phone", "value": "={{ $json.body.phone || '' }}", "type": "string" },
            { "id": "b4", "name": "subject", "value": "={{ $json.body.subject || 'General Inquiry' }}", "type": "string" },
            { "id": "b5", "name": "message", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "b6", "name": "source", "value": "contact_form", "type": "string" },
            { "id": "b7", "name": "page", "value": "={{ $json.body.page || '/contact' }}", "type": "string" },
            { "id": "b8", "name": "timestamp", "value": "={{ $json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "extract-form",
      "name": "Extract Form Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "name", "value": "={{ $json.body.name || 'Visitor' }}", "type": "string" },
            { "id": "c2", "name": "email", "value": "={{ $json.body.email || '' }}", "type": "string" },
            { "id": "c3", "name": "message", "value": "={{ $json.body.message || 'WhatsApp click' }}", "type": "string" },
            { "id": "c4", "name": "source", "value": "whatsapp_click", "type": "string" },
            { "id": "c5", "name": "page", "value": "={{ $json.body.page || '/' }}", "type": "string" },
            { "id": "c6", "name": "timestamp", "value": "={{ $json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "extract-whatsapp",
      "name": "Extract WhatsApp Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 580]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "d1", "name": "name", "value": "={{ $json.body.name || 'Visitor' }}", "type": "string" },
            { "id": "d2", "name": "email", "value": "={{ $json.body.email || '' }}", "type": "string" },
            { "id": "d3", "name": "phone", "value": "={{ $json.body.phone || '' }}", "type": "string" },
            { "id": "d4", "name": "product", "value": "={{ $json.body.product }}", "type": "string" },
            { "id": "d5", "name": "message", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "d6", "name": "quantity", "value": "={{ $json.body.quantity || '1' }}", "type": "string" },
            { "id": "d7", "name": "source", "value": "product_inquiry", "type": "string" },
            { "id": "d8", "name": "page", "value": "={{ $json.body.page || '/products' }}", "type": "string" },
            { "id": "d9", "name": "timestamp", "value": "={{ $json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
